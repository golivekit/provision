{
  "name": "@golivekit/provision",
  "version": "1.0.0",
  "description": "Interactive CLI for provisioning GoLiveKit infrastructure via Terraform",
  "type": "module",
  "bin": {
    "provision": "./dist/index.js"
  },
  "files": [
    "dist",
    "terraform"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/sync-terraform.mjs && tsc",
    "dev": "tsc --watch",
    "prepack": "pnpm build",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.2",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}