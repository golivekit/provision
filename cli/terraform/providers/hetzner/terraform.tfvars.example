# Copy to terraform.tfvars and fill in the values.
# terraform.tfvars is git-ignored — never commit secrets.

hcloud_token   = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

server_name     = "golivekit-prod"
location        = "nbg1"   # Nuremberg | fsn1 = Falkenstein | hel1 = Helsinki | ash = Ashburn | sin = Singapore
server_type     = "cx22"   # 2 vCPU / 4 GB RAM  |  cx32 = 4 vCPU / 8 GB
image           = "ubuntu-24.04"
backups_enabled = false
ipv4_enabled    = true
ipv6_enabled    = true

labels = {
  env = "production"
  app = "golivekit"
}
