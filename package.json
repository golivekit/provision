{
  "name": "@golivekit/provision",
  "version": "1.0.4",
  "description": "Interactive CLI for provisioning GoLiveKit infrastructure via Terraform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golivekit/provision.git"
  },
  "homepage": "https://golivekit.com/",
  "bugs": {
    "url": "https://github.com/golivekit/provision/issues"
  },
  "packageManager": "pnpm@8.15.5",
  "license": "MIT",
  "keywords": [
    "terraform",
    "provisioning",
    "vps",
    "digitalocean",
    "hetzner",
    "aws",
    "golivekit"
  ],
  "type": "module",
  "bin": {
    "provision": "./dist/index.js"
  },
  "files": [
    "dist",
    "terraform"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "pnpm build",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1032.0",
    "@aws-sdk/client-pricing": "^3.1032.0",
    "@aws-sdk/client-sts": "^3.1032.0",
    "@inquirer/prompts": "^7.5.2",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
