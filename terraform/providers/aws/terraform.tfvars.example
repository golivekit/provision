# Copy to terraform.tfvars and fill in the values.
# Prefer using ~/.aws/credentials or an IAM instance role over hardcoded keys.
# terraform.tfvars is git-ignored — never commit secrets.

# Leave blank to use ~/.aws/credentials / environment variables / IAM role
aws_access_key = ""
aws_secret_key = ""

ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

aws_region          = "eu-central-1"   # Frankfurt | us-east-1 | us-west-2 | ap-southeast-1
server_name         = "golivekit-prod"
instance_type       = "t3.small"       # t3.micro (free tier) | t3.medium | t3.large
ami_id              = ""               # leave empty for auto Ubuntu 24.04 lookup
root_volume_size_gb = 30
backups_enabled     = false
ipv4_enabled        = true
ipv6_enabled        = false

tags = {
  Environment = "production"
  App         = "golivekit"
}
