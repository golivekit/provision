# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is git-ignored — never commit secrets.

do_token       = "dop_v1_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

server_name     = "golivekit-prod"
region          = "fra1"   # Amsterdam: ams3  |  NYC: nyc3  |  SF: sfo3  |  Singapore: sgp1
size            = "s-2vcpu-4gb"
image           = "ubuntu-24-04-x64"
backups_enabled = false
ipv4_enabled    = true
ipv6_enabled    = false
tags            = ["production", "app"]
